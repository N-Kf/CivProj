# Optional process configuration. Copying this file does not load it automatically;
# export these variables in your shell or supply them through your process manager.
# Default database: backend/data/civproj.sqlite3 (ignored by Git).
# CIVPROJ_DB=/absolute/path/to/civproj.sqlite3
# Comma-separated exact browser origins, without trailing slash.
# CIVPROJ_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 when the application is served over HTTPS.
# CIVPROJ_SECURE_COOKIE=1
