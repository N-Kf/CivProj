{
  "name": "civproj-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "build:demo": "tsc -b && vite build --config vite.demo.config.ts",
    "test:demo": "npm run build:demo && playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.7.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
